public abstract class Multimedia {
    protected int codigo;
    protected String titulo;
    protected String autor;
    protected boolean estadoDisponibilidad;

    public Multimedia(int codigo, String titulo, String autor, boolean estadoDisponibilidad) {
        this.codigo = codigo;
        this.titulo = titulo;
        this.autor = autor;
        this.estadoDisponibilidad = estadoDisponibilidad;
    }

    public int getCodigo() {
        return codigo ;
    }

    public String getTitulo() {
        return titulo;
    }

    public String getAutor() {
        return autor;
    }

    public boolean isEstadoDisponibilidad() {
        return estadoDisponibilidad;
    }

    public void setCodigo(int codigo) {
        this.codigo = codigo;
    }

    public void setTitulo(String titulo) {
        this.titulo = titulo;
    }

    public void setAutor(String autor) {
        this.autor = autor;
    }

    public void setEstadoDisponibilidad(boolean estadoDisponibilidad) {
        this.estadoDisponibilidad = estadoDisponibilidad;
    }

    public abstract void mostrarInfo();
}
